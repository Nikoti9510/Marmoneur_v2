---
import { getCollection } from 'astro:content';
import { Debug } from 'astro:components';

const posts = await getCollection('content', ({ data }) => {
  return data.draft === false && data.tags == "jdr";
});
---

{posts.map((post) => (
      <li><a href={`/jdr/${post.id}`}>{post.data.title}</a></li>
))}