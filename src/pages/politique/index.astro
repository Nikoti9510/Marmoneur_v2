---
import { getCollection } from 'astro:content';
import Layout from "../../layouts/Layout.astro";

const posts = await getCollection('politique', ({ data }) => {
  return data.draft === false;
});
---
<Layout>
  if isEmptyObjecct(posts) {
    <p>Pas de page à ce sujet</p>
  }
  else {
    posts.map((post) => (
      <li><a href={`/politique/${post.id}`}>{post.data.title}</a></li>
    ))
  }
  <!-- {posts.map((post) => (
        <li><a href={`/politique/${post.id}`}>{post.data.title}</a></li>
  ))} -->
</layout>