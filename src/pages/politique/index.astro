---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('content');
  const publishedPosts = posts.filter((post) => post.data.draft === false && post.data.tags == "politique");
  return publishedPosts.map(post => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;

---
<Layout>
	<h1> Politique </h1>
    <p>Liste des posts de la catégorie</p> 
    <nav>
        <ul>
            <li><a href={post.url}>{post.frontmatter.title}</a></li>
        </ul>
	</nav>
</Layout>