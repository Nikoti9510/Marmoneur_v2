---
import { getCollection } from 'astro:content';
import Layout from "../layouts/Layout.astro";

const posts = await getCollection('content', ({ data }) => {
  return data.draft === false && data.tags == "politique";
});
---
<Layout>
  {posts.map((post) => (
        <li><a href={`/politique/${post.id}`}>{post.data.title}</a></li>
  ))}
</layout>