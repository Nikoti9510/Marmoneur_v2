---
import { getCollection } from 'astro:content';
import Layout from "../../layouts/Layout.astro";

const posts = await getCollection('politique', ({ data }) => {
  return data.draft === false;
});
---
<Layout>

{ (posts.size === 0) 
  ? 
    <p>Pas de page à ce sujet</p> 
  : 
    posts.map((post) => (
      <li><a href={`/politique/${post.id}`}>{post.data.title}</a></li>
    )) 
}

  <!-- {posts.map((post) => (
        <li><a href={`/politique/${post.id}`}>{post.data.title}</a></li>
  ))} -->
</layout>