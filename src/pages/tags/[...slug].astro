---
import Layout from "../../layouts/Layout.astro";
let title = 'Tags';
const allPosts = await Astro.fetchContent('../content/blog/*.md');
const tags = [...new Set([].concat.apply([],allPosts.map(post => post.tags)))]
---
<Layout>
    <div >
        {tags.sort().map((tag) => (
            <p><a href={`/tags/${tag}`}>{tag}</a></p>
        ))}
    </div>
</Layout>
