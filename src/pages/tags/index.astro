---
import Layout from "../../layouts/Layout.astro";

// Récupère tout les posts dans le dossier "content".
const allPosts = Object.values(import.meta.glob('../../content/*.md', { eager: true }));

// Fait la liste de tout les tags existant dans les posts (en excluant le tag "vide").
const uniqueTags = [...new Set(allPosts.map((post: any) => post.frontmatter.tags.filter(item => !item.includes("vide"))).flat())];

---

<Layout>
	<h1> voilou les tags </h1>
    <div>
        {uniqueTags.map((tag) => (
            <p><a href={`/tags/${tag}`}>{tag}</a></p>
        ))}
    </div>
</Layout>
