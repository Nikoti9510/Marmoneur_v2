---
import { getCollection } from 'astro:content';
import Layout from "../../layouts/Layout.astro";

const posts = await getCollection('allPages', ({ data }) => {
  return data.draft === false;
});
---
<Layout>
  {posts.map((post) => (
        <li><a href={`/all/${post.id}`}>{post.data.title}</a></li>
  ))}
</layout>