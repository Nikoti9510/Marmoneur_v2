---
const props = Astro.props;
---

<div {...props} class="sidenote">
    <div class="grid-context">
        <aside>
            <slot />
        </aside>
    </div>
</div>

<style>
    @layer components {
        .sidenote {
            display: inline;
            & > .grid-context {
                display: grid;
                grid-template-columns: subgrid;
                position: relative;

                & > aside {
                    width: 50%;
                    font-size: 0.8rem;
                    padding: var(--space, 1rem);
                    box-shadow: var(--shadow);
                    border-radius: var(--radius);
                    line-height: var(--line-height__special);
                    background-color: var(--background-accent);
                }
            }
            &::after {
                content: "";
                height: 2px;
                background-color: var(--background-accent);
                position: absolute;
                right: 0;
            }
        }
    }
</style>
